{
  "name": "dns-worker",
  "version": "1.1.5",
  "private": false,
  "description": "Privacy-first DNS & DoH Resolver with modern Web Dashboard, built for Cloudflare Workers & Node.js",
  "main": "./dist/serverfull.mjs",
  "bin": {
    "dns-worker": "./dist/serverfull.mjs",
    "obexdns": "./dist/serverfull.mjs"
  },
  "files": [
    "dist/",
    "static/",
    "migrations/",
    ".env.serverfull",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "npm run db:migrate:dev && concurrently \"npm run ui:dev\" \"wrangler dev\"",
    "start": "npm run build && wrangler dev",
    "start:serverfull": "npm run build:serverfull && node --enable-source-maps dist/serverfull.mjs",
    "serverfull": "npm run build:serverfull && node --enable-source-maps dist/serverfull.mjs",
    "build:serverfull": "npm run ui:build && npx esbuild src/serverfull/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/serverfull.mjs --banner:js=\"#!/usr/bin/env node\" --external:node:sqlite --minify --sourcemap --tree-shaking=true --legal-comments=none",
    "prepublishOnly": "npm run build:serverfull",
    "service-create:linux": "tsx scripts/create-linux-service.ts",
    "docker:build": "tsx scripts/docker.ts build",
    "docker:build:alpha": "tsx scripts/docker.ts build --alpha",
    "docker:build:multiarch": "tsx scripts/docker.ts multiarch",
    "docker:push": "tsx scripts/docker.ts push",
    "docker:push:alpha": "tsx scripts/docker.ts push --alpha",
    "docker:run": "tsx scripts/docker.ts run",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:convert-tw": "npm --prefix docs run convert-tw",
    "deploy": "npm run build && npm run db:migrate:prod && wrangler deploy",
    "deploy:skipdb": "npm run build && wrangler deploy",
    "build": "npm run ui:build",
    "build:pages": "npm run ui:build && npx esbuild src/index.ts --bundle --outfile=static/_worker.js --platform=neutral --format=esm --minify --external:cloudflare:* --external:node:*",
    "prepare": "npm run ui:install",
    "db:setup": "wrangler d1 create dns_worker_db",
    "db:migrate:dev": "wrangler d1 migrations apply dns_worker_db --local",
    "db:migrate:prod": "tsx scripts/migrate-prod.ts",
    "db:status": "wrangler d1 execute dns_worker_db --local --command='SELECT name FROM sqlite_master WHERE type=\"table\"'",
    "test": "tsx test/test_legacy_compat.ts",
    "test:compat": "tsx test/test_legacy_compat.ts",
    "test:turso": "tsx test/test_turso.ts",
    "test:turnstile": "tsx test/test_turnstile.ts",
    "test:serverfull": "tsx test/test_serverfull.ts",
    "test:reset": "tsx test/test_serverfull_reset.ts",
    "lint": "oxlint",
    "ui:dev": "cd web && npm run dev",
    "ui:build": "cd web && npm run build",
    "ui:install": "cd web && npm install",
    "tag-promote": "npm version patch",
    "tag-push": "git push && git push --tags"
  },
  "keywords": [
    "dns",
    "cloudflare-workers",
    "doh",
    "ad-blocking",
    "privacy"
  ],
  "author": "Hugo Koo",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Obein/DNS-Worker.git"
  },
  "homepage": "https://github.com/Obein/DNS-Worker#readme",
  "bugs": {
    "url": "https://github.com/Obein/DNS-Worker/issues"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "undici": "^7.30.1"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.7.1"
  }
}
